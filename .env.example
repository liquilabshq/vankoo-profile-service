# Puerto HTTP del servicio
PORT=3000

# Base de datos (Postgres)
PROFILE_DB_HOST=localhost
PROFILE_DB_PORT=5432
PROFILE_DB_USER=vankoo
PROFILE_DB_PASS=vankoo
PROFILE_DB_NAME=vankoo_profiles
# true en Azure (Azure Database for PostgreSQL exige TLS); false en local
PROFILE_DB_SSL=false

# Kafka. KAFKA_ENABLED=false arranca sin broker: no se consumen eventos y los salientes
# solo se escriben en el log (Azure mientras no exista el Event Hub).
KAFKA_ENABLED=true
# Uno o varios brokers separados por comas
KAFKA_BROKERS=localhost:9092
# Solo para un broker gestionado (Azure Event Hubs): KAFKA_SSL=true, mecanismo plain,
# usuario $ConnectionString y como contraseña la cadena de conexión del namespace.
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Almacenamiento de archivos: elige el proveedor con STORAGE_PROVIDER (minio | s3).
# "minio" es el default si no se define — pensado para desarrollo local.
STORAGE_PROVIDER=minio

# MinIO (desarrollo local)
MINIO_ENDPOINT=localhost
MINIO_PORT=9100
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=vankoo-profile-documents
MINIO_PRESIGNED_EXPIRY_SECONDS=300
# Opcional: URL pública base para construir el fileUrl final. Si no se define,
# se calcula a partir de MINIO_ENDPOINT/MINIO_PORT/MINIO_USE_SSL.
# MINIO_PUBLIC_URL=http://localhost:9100/vankoo-profile-documents

# Amazon S3 (staging/producción — activar con STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_S3_BUCKET=vankoo-profile-documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PRESIGNED_EXPIRY_SECONDS=300
# Opcional: URL pública base para construir el fileUrl final. Si no se define,
# se calcula como https://<bucket>.s3.<region>.amazonaws.com
# AWS_S3_PUBLIC_URL=https://vankoo-profile-documents.s3.us-east-1.amazonaws.com

# Descubrimiento de servicios (Eureka / Discovery Server).
# EUREKA_ENABLED=false en Azure: allí no hay Discovery Server y el gateway llega por DNS interno.
EUREKA_ENABLED=true
EUREKA_HOST=localhost
EUREKA_PORT=8761
INSTANCE_HOSTNAME=localhost

# Verificación automática del DNI del inversor (función serverless vankoo-dni-verification-function).
# Apagada por defecto: el KYC del inversor sigue siendo manual. Para probar en local con la
# extensión Azure Functions de VS Code: URL=http://localhost:7071/api/verify-dni (sin clave).
# Si profile corre en Docker, usar http://host.docker.internal:7071/api/verify-dni.
DNI_VERIFICATION_ENABLED=false
DNI_VERIFICATION_URL=http://localhost:7071/api/verify-dni
DNI_VERIFICATION_KEY=
DNI_VERIFICATION_TIMEOUT_MS=15000
