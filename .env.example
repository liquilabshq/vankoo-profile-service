# Base de datos (Postgres)
PROFILE_DB_HOST=localhost
PROFILE_DB_PORT=5432
PROFILE_DB_USER=vankoo
PROFILE_DB_PASS=vankoo
PROFILE_DB_NAME=vankoo_profiles

# Almacenamiento de archivos: elige el proveedor con STORAGE_PROVIDER (minio | s3).
# "minio" es el default si no se define — pensado para desarrollo local.
STORAGE_PROVIDER=minio

# MinIO (desarrollo local)
MINIO_ENDPOINT=localhost
MINIO_PORT=9100
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=vankoo-profile-documents
MINIO_PRESIGNED_EXPIRY_SECONDS=300
# Opcional: URL pública base para construir el fileUrl final. Si no se define,
# se calcula a partir de MINIO_ENDPOINT/MINIO_PORT/MINIO_USE_SSL.
# MINIO_PUBLIC_URL=http://localhost:9100/vankoo-profile-documents

# Amazon S3 (staging/producción — activar con STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_S3_BUCKET=vankoo-profile-documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PRESIGNED_EXPIRY_SECONDS=300
# Opcional: URL pública base para construir el fileUrl final. Si no se define,
# se calcula como https://<bucket>.s3.<region>.amazonaws.com
# AWS_S3_PUBLIC_URL=https://vankoo-profile-documents.s3.us-east-1.amazonaws.com

# Descubrimiento de servicios (Eureka / Discovery Server)
EUREKA_HOST=localhost
EUREKA_PORT=8761
INSTANCE_HOSTNAME=localhost
